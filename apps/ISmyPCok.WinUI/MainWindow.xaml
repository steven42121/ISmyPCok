<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ISmyPCokWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="TitleText"
                       Text="ISmyPCok"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="ScenarioCombo" Header="Scenario" MinWidth="200"/>
            <TextBox x:Name="ModulesBox"
                     Header="Modules (comma separated, empty = all)"
                     PlaceholderText="cpu_fp32,memory_bw,net_bw,net_rtt"
                     Width="360"
                     VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="RunButton"
                    Content="Run"
                    Click="RunButton_Click"
                    IsEnabled="False"/>
            <ProgressRing x:Name="BusyRing"
                          IsActive="False"
                          Width="24"
                          Height="24"
                          VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="Result"
                   Style="{StaticResource SubtitleTextBlockStyle}"/>

        <TextBox x:Name="ResultBox"
                 Grid.Row="4"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"/>
    </Grid>
</Window>
