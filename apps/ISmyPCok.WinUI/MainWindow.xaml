<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ISmyPCokWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="TitleText"
                       Text="ISmyPCok"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="ScenarioCombo" Header="Scenario" MinWidth="200"/>
            <TextBox x:Name="ModulesBox"
                     Header="Modules (comma separated, empty = all)"
                     PlaceholderText="cpu_fp32,memory_bw,net_bw,net_rtt"
                     Width="360"
                     VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="RunButton"
                    Content="Run"
                    Click="RunButton_Click"
                    IsEnabled="False"/>
            <ProgressRing x:Name="BusyRing"
                          IsActive="False"
                           Width="24"
                           Height="24"
                           VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDetailText"
                           Text="Choose a scenario and run the benchmark."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,12,12">
                <Border x:Name="ScenarioCard"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Scenario summary" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ScenarioNameText" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BottlenecksText" TextWrapping="Wrap" Opacity="0.75"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="TOTAL SCORE" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <TextBlock x:Name="ScenarioScoreText" FontSize="32" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="Module results" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="EmptyModulesText"
                               Text="No module results are available."
                               Opacity="0.7"
                               Visibility="Collapsed"/>
                    <ItemsControl x:Name="ModuleCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <Expander x:Name="RawJsonExpander" Header="Raw JSON" IsExpanded="False">
                    <TextBox x:Name="RawJsonBox"
                             MinHeight="180"
                             MaxHeight="420"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
